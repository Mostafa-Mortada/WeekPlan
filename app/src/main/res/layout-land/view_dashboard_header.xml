<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    app:layout_scrollFlags="@integer/agenda_header_scroll_flags">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                style="@style/WP.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/planner_brand"
                android:textSize="24sp" />
            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/dashboard_tag"
                style="@style/WP.Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/planner_badge_today"
                app:neoFill="@color/wp_green"
                app:neoShadow="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/dashboard_date"
            style="@style/WP.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/dashboard_count"
            style="@style/WP.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp">
        <com.weekplan.reminders.ui.NeoTextView
            android:id="@+id/dashboard_action_add"
            style="@style/WP.Text.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_add_event"
            app:neoFill="@color/wp_yellow"
            app:neoShadow="3dp"
            app:neoStroke="2dp" />
        <com.weekplan.reminders.ui.NeoTextView
            android:id="@+id/dashboard_action_planner"
            style="@style/WP.Text.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_view_week"
            app:neoFill="@color/wp_paper"
            app:neoShadow="3dp"
            app:neoStroke="2dp" />
    </LinearLayout>
</LinearLayout>
