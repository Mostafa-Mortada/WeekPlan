<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/dashboard_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wp_bg"
        app:elevation="0dp"
        app:liftOnScroll="false">
        <include layout="@layout/view_dashboard_header"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboard_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">
            <com.weekplan.reminders.ui.NeoLinearLayout
                android:id="@+id/next_up_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                app:neoFill="@color/wp_purple"
                app:neoShadow="5dp"
                tools:visibility="visible">
                <com.weekplan.reminders.ui.NeoTextView
                    android:id="@+id/next_up_badge"
                    style="@style/WP.Text.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_next_up"
                    app:neoFill="@color/wp_yellow"
                    app:neoShadow="2dp"
                    app:neoStroke="2dp"/>
                <TextView
                    android:id="@+id/next_up_title"
                    style="@style/WP.Text.Display"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/wp_ink"
                    android:textSize="20sp"
                    tools:text="Mobile Computing Sync"/>
                <TextView
                    android:id="@+id/next_up_time"
                    style="@style/WP.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    tools:text="10:00 AM → 11:30 AM"/>
                <TextView
                    android:id="@+id/next_up_meta"
                    style="@style/WP.Text.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    tools:text="↻ Daily · Reminder: 15 min before"/>
            </com.weekplan.reminders.ui.NeoLinearLayout>
            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/dashboard_all_done_banner"
                style="@style/WP.Text.Chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/dashboard_all_done"
                android:visibility="gone"
                app:neoFill="@color/wp_green"
                app:neoShadow="3dp"
                app:neoStroke="2dp"/>
            <TextView
                style="@style/WP.Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/dashboard_schedule"
                android:textColor="@color/wp_ink"
                android:textSize="18sp"/>
            <com.weekplan.reminders.ui.NeoLinearLayout
                android:id="@+id/dashboard_empty_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone"
                app:neoDashed="true"
                app:neoFill="@color/wp_paper"
                app:neoShadow="0dp"
                app:neoStroke="2dp">
                <TextView
                    style="@style/WP.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_empty_title"
                    android:textColor="@color/wp_ink"
                    android:textSize="17sp"/>
                <TextView
                    style="@style/WP.Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/dashboard_empty_body"
                    android:textColor="@color/wp_ink"/>
                <com.weekplan.reminders.ui.NeoTextView
                    android:id="@+id/dashboard_empty_add_btn"
                    style="@style/WP.Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/planner_add_event"
                    app:neoFill="@color/wp_yellow"
                    app:neoShadow="3dp"
                    app:neoStroke="2dp"/>
            </com.weekplan.reminders.ui.NeoLinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dashboard_events_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="visible"/>
            <com.weekplan.reminders.ui.NeoLinearLayout
                android:id="@+id/dashboard_error_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                app:neoFill="@color/wp_paper"
                app:neoShadow="4dp"
                app:neoStroke="2dp">
                <TextView
                    style="@style/WP.Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_error_title"
                    android:textColor="@color/wp_ink"
                    android:textSize="16sp"/>
                <com.weekplan.reminders.ui.NeoTextView
                    android:id="@+id/dashboard_retry_btn"
                    style="@style/WP.Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/planner_retry"
                    app:neoFill="@color/wp_yellow"
                    app:neoShadow="3dp"
                    app:neoStroke="2dp"/>
            </com.weekplan.reminders.ui.NeoLinearLayout>
            <ProgressBar
                android:id="@+id/dashboard_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
