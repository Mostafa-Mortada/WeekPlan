<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/WP.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/planner_brand"
                android:textColor="@color/wp_ink"
                android:textSize="30sp" />

            <com.weekplan.reminders.ui.NeoTextView
                style="@style/WP.Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:rotation="-3"
                android:text="@string/planner_tag"
                app:neoFill="@color/wp_yellow"
                app:neoShadow="3dp" />
        </LinearLayout>

        <!-- Form heading -->
        <TextView
            android:id="@+id/form_heading"
            style="@style/WP.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/event_form_title"
            android:textColor="@color/wp_ink"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/event_form_subtitle"
            android:textColor="@color/wp_ink" />

        <!-- Form card -->
        <com.weekplan.reminders.ui.NeoLinearLayout
            android:id="@+id/event_form_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="16dp"
            app:neoFill="@color/wp_paper"
            app:neoShadow="6dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/event_title_label"
                android:labelFor="@id/event_title"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/event_title"
                android:maxLength="@integer/event_title_max_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/wp_ink"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:minHeight="48dp"
                android:padding="10dp"
                android:textColor="@color/wp_ink"
                android:textColorHint="#777777" />

            <TextView
                android:id="@+id/event_title_count"
                style="@style/WP.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="4dp" />

            <!-- Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/event_date_label"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_date"
                style="@style/WP.Text.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/event_date_choose"
                app:neoFill="@color/wp_yellow"
                app:neoShadow="3dp"
                app:neoStroke="2dp" />

            <!-- Start time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/event_start_time_label"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_start_time"
                style="@style/WP.Text.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/event_start_time_choose"
                app:neoFill="@color/wp_green"
                app:neoShadow="3dp"
                app:neoStroke="2dp" />

            <!-- End time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/event_end_time_label"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_end_time"
                style="@style/WP.Text.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/event_end_time_choose"
                app:neoFill="@color/wp_paper"
                app:neoShadow="3dp"
                app:neoStroke="2dp" />

            <!-- Reminder -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/event_details_reminder"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_reminder"
                style="@style/WP.Text.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/settings_offset_15"
                app:neoFill="@color/wp_paper"
                app:neoShadow="3dp"
                app:neoStroke="2dp" />

            <!-- Repeat switch row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_repeat_heading"
                        android:textColor="@color/wp_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/event_repeat_label"
                        android:textColor="@color/wp_ink"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.weekplan.reminders.ui.NeoSwitch
                    android:id="@+id/repeat_switch"
                    android:contentDescription="@string/event_repeat_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Repeat options: hidden when switch is OFF -->
            <LinearLayout
                android:id="@+id/repeat_options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/event_repeat_frequency"
                    android:textColor="@color/wp_ink"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/repeat_frequency_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <com.weekplan.reminders.ui.NeoRadioButton
                        android:id="@+id/repeat_daily"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_repeat_daily"
                        android:textColor="@color/wp_ink" />

                    <com.weekplan.reminders.ui.NeoRadioButton
                        android:id="@+id/repeat_weekly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_repeat_weekly"
                        android:textColor="@color/wp_ink" />
                </RadioGroup>

                <!-- Weekday selection: visible only for Weekly -->
                <LinearLayout
                    android:id="@+id/weekly_days_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/event_repeat_choose_days"
                        android:textColor="@color/wp_ink"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_monday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_monday"
                            android:textColor="@color/wp_ink" />

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_tuesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_tuesday"
                            android:textColor="@color/wp_ink" />

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_wednesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_wednesday"
                            android:textColor="@color/wp_ink" />

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_thursday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_thursday"
                            android:textColor="@color/wp_ink" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_friday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_friday"
                            android:textColor="@color/wp_ink" />

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_saturday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_saturday"
                            android:textColor="@color/wp_ink" />

                        <com.weekplan.reminders.ui.NeoCheckBox
                            android:id="@+id/day_sunday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekday_sunday"
                            android:textColor="@color/wp_ink" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Notes -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/event_notes_label"
                android:labelFor="@id/event_notes"
                android:textColor="@color/wp_ink"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/event_notes"
                android:maxLength="@integer/event_notes_max_length"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/wp_ink"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="flagNoExtractUi"
                android:minHeight="100dp"
                android:minLines="3"
                android:padding="10dp"
                android:textColor="@color/wp_ink"
                android:textColorHint="#777777" />

            <TextView
                android:id="@+id/event_notes_count"
                style="@style/WP.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginTop="4dp" />

        </com.weekplan.reminders.ui.NeoLinearLayout>

        <!-- Validation error -->
        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#C62828"
            android:visibility="gone" />

        <com.weekplan.reminders.ui.NeoTextView
            android:id="@+id/form_retry"
            style="@style/WP.Text.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_storage_retry"
            android:visibility="gone"
            app:neoFill="@color/wp_yellow" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_cancel"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/event_cancel"
                app:neoFill="@color/wp_paper"
                app:neoShadow="3dp"
                app:neoStroke="2dp" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/event_save"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/event_save"
                app:neoFill="@color/wp_yellow"
                app:neoShadow="4dp"
                app:neoStroke="2dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
