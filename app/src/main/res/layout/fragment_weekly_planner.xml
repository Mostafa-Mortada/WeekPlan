<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wp_bg"
    android:orientation="vertical">

    <!-- Brand row, like the website's top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp">

        <TextView
            style="@style/WP.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_brand"
            android:textColor="@color/wp_ink"
            android:textSize="30sp" />

        <com.weekplan.reminders.ui.NeoTextView
            style="@style/WP.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:rotation="-3"
            android:text="@string/planner_tag"
            app:neoFill="@color/wp_yellow"
            app:neoShadow="3dp" />
    </LinearLayout>

    <TextView
        style="@style/WP.Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/planner_tagline" />

    <!-- Week range + navigation -->
    <com.weekplan.reminders.ui.NeoLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:neoFill="@color/wp_paper"
        app:neoShadow="6dp">

        <TextView
            android:id="@+id/week_range"
            style="@style/WP.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_ink"
            android:textSize="24sp"
            tools:text="Oct 19 – 25, 2026" />

        <com.weekplan.reminders.ui.NeoTextView
            android:id="@+id/week_chip"
            style="@style/WP.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:neoFill="@color/wp_green"
            app:neoShadow="2dp"
            app:neoStroke="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/week_prev"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/planner_cd_prev"
                android:text="@string/planner_prev"
                app:neoFill="@color/wp_paper" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/week_today"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/planner_cd_today_button"
                android:text="@string/planner_today"
                app:neoFill="@color/wp_yellow" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/week_next"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/planner_cd_next"
                android:text="@string/planner_next"
                app:neoFill="@color/wp_paper" />
        </LinearLayout>
    </com.weekplan.reminders.ui.NeoLinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/planner_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp" />
</LinearLayout>
