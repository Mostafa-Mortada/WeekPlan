<?xml version="1.0" encoding="utf-8"?>
<!-- Day header: like the website's grid day cell. Fill turns green for today (set in code). -->
<com.weekplan.reminders.ui.NeoLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="18dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    app:neoFill="@color/wp_paper"
    app:neoShadow="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/day_name"
                style="@style/WP.Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/wp_ink"
                android:textSize="18sp"
                tools:text="Monday" />

            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/today_badge"
                style="@style/WP.Text.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/planner_badge_today"
                android:visibility="gone"
                app:neoFill="@color/wp_yellow"
                app:neoShadow="2dp"
                app:neoStroke="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/day_subtitle"
            style="@style/WP.Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Oct 19 · 3 events" />
    </LinearLayout>

    <!-- Like .icon-btn: adds an event on this day -->
    <com.weekplan.reminders.ui.NeoTextView
        android:id="@+id/day_add"
        style="@style/WP.Text.Button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="+"
        android:textSize="22sp"
        app:neoFill="@color/wp_paper"
        app:neoShadow="3dp"
        app:neoStroke="2dp"
        tools:ignore="HardcodedText" />
</com.weekplan.reminders.ui.NeoLinearLayout>
