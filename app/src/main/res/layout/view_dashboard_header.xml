<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    app:layout_scrollFlags="@integer/agenda_header_scroll_flags">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/WP.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/planner_brand"
            android:textColor="@color/wp_ink"
            android:textSize="30sp"/>
        <com.weekplan.reminders.ui.NeoTextView
            android:id="@+id/dashboard_tag"
            style="@style/WP.Text.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:rotation="-3"
            android:text="@string/planner_badge_today"
            app:neoFill="@color/wp_green"
            app:neoShadow="3dp"/>
    </LinearLayout>
    <TextView
        style="@style/WP.Text.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/planner_tagline"/>
    <com.weekplan.reminders.ui.NeoLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:neoFill="@color/wp_paper"
        app:neoShadow="6dp">
        <TextView
            android:id="@+id/dashboard_date"
            style="@style/WP.Text.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_ink"
            android:textSize="24sp"
            tools:text="Wednesday, Oct 30"/>
        <TextView
            android:id="@+id/dashboard_count"
            style="@style/WP.Text.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/wp_ink"
            android:textSize="13sp"
            tools:text="3 events scheduled today"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/dashboard_action_add"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/dashboard_add_event"
                app:neoFill="@color/wp_yellow"
                app:neoShadow="3dp"
                app:neoStroke="2dp"/>
            <com.weekplan.reminders.ui.NeoTextView
                android:id="@+id/dashboard_action_planner"
                style="@style/WP.Text.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dashboard_view_week"
                app:neoFill="@color/wp_paper"
                app:neoShadow="3dp"
                app:neoStroke="2dp"/>
        </LinearLayout>
    </com.weekplan.reminders.ui.NeoLinearLayout>
</LinearLayout>
